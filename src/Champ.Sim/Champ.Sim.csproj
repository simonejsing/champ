<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Left off deliberately: Unity 2022.3 compiles these .cs files itself via the asmdef,
         its bundled Roslyn is capped at C# 9, and it ignores -langversion overrides from an
         asmdef-adjacent .rsp file. ImplicitUsings' generated GlobalUsings.g.cs (a C# 10
         construct) would otherwise get swept into that build from obj/ and fail it, and
         every file here already has the explicit `using`s it needs, so nothing relies on it. -->
    <RootNamespace>Champ.Sim</RootNamespace>
  </PropertyGroup>
</Project>
