{
  // A run entry, not a debug entry. js-debug -- the JavaScript debugger built into VS Code and
  // Cursor -- launches whatever "runtimeExecutable" names, and "noDebug" tells it not to wait
  // for a debugger to attach, so this runs PowerShell perfectly well. outputCapture std is what
  // puts the build's output in the Debug Console; the default reads through the debugger
  // protocol, which noDebug disables, leaving it silent through the whole build.
  //
  // Cursor marks "noDebug" as not allowed: it is a DAP launch-request field rather than part of
  // js-debug's own schema, and VS Code passes it through. The warning is cosmetic; drop the
  // property and the session waits for an attach that never comes.
  //
  // Breakpoints are the thing that would need an extension, and none is configured.
  "version": "0.2.0",
  "configurations": [
    {
      // Unity has no incremental run: this is the batchmode player build, then the exe.
      "name": "Run Unity",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "scripts/unity.ps1",
        "-Run"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "outputCapture": "std",
      "noDebug": true
    }
  ]
}
